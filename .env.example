# FinOps SaaS - Local Development Environment Variables
# Copy this file to .env and adjust as needed

# ============================================================================
# POSTGRES
# ============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=finops
POSTGRES_USER=finops
POSTGRES_PASSWORD=finops_dev_password
POSTGRES_MAX_CONNECTIONS=100

# ============================================================================
# REDIS
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password

# ============================================================================
# KAFKA
# ============================================================================
KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_AUTO_CREATE_TOPICS=true

# ZOOKEEPER
ZOOKEEPER_HOST=zookeeper
ZOOKEEPER_PORT=2181
ZOOKEEPER_CLIENT_PORT=2181

# ============================================================================
# MINIO (S3-compatible object storage)
# ============================================================================
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_DEFAULT_BUCKETS=raw-costs,normalized-costs,reports,exports

# ============================================================================
# TRINO (Query Engine)
# ============================================================================
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_COORDINATOR=true
TRINO_DISCOVERY_URI=http://trino:8080

# ============================================================================
# KEYCLOAK (SSO/Auth)
# ============================================================================
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_VENDOR=postgres
KEYCLOAK_DB_ADDR=postgres
KEYCLOAK_DB_DATABASE=keycloak
KEYCLOAK_DB_USER=finops
KEYCLOAK_DB_PASSWORD=finops_dev_password

# ============================================================================
# MAILHOG (Email Testing)
# ============================================================================
MAILHOG_HOST=mailhog
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ============================================================================
# OPENTELEMETRY COLLECTOR
# ============================================================================
OTEL_COLLECTOR_HOST=otel-collector
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
OTEL_COLLECTOR_HEALTH_CHECK_PORT=13133

# ============================================================================
# PROMETHEUS (Metrics)
# ============================================================================
PROMETHEUS_HOST=prometheus
PROMETHEUS_PORT=9090

# ============================================================================
# GRAFANA (Observability)
# ============================================================================
GRAFANA_HOST=grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_ENV=development
LOG_LEVEL=debug
API_PORT=8000

# ============================================================================
# DOCKER NETWORK
# ============================================================================
COMPOSE_PROJECT_NAME=finops-saas
DOCKER_NETWORK=finops-network
