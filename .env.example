# Environment Configuration Example
# Copy this file to .env and update with your values

# Application
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/finops_db
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Object Storage (S3/MinIO compatible)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=finops-data
OBJECT_STORAGE_REGION=us-east-1

# Message Queue (Kafka/RabbitMQ)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=finops-saas
KAFKA_GROUP_ID=finops-consumer

# Query Engine (Trino)
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_CATALOG=hive
TRINO_SCHEMA=default

# Authentication
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRATION=24h
SESSION_SECRET=your-session-secret-change-this

# OIDC/SSO
OIDC_ISSUER=http://localhost:8080/auth/realms/finops
OIDC_CLIENT_ID=finops-web
OIDC_CLIENT_SECRET=change-this
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# SAML
SAML_ENTRY_POINT=
SAML_ISSUER=
SAML_CERT=

# Cloud Provider Credentials (use Secrets Manager in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

GCP_PROJECT_ID=
GCP_CREDENTIALS_PATH=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=finops-saas
JAEGER_ENDPOINT=http://localhost:14268/api/traces
PROMETHEUS_PUSHGATEWAY=http://localhost:9091

# Feature Flags
FEATURE_FLAG_PROVIDER=local
LAUNCHDARKLY_SDK_KEY=

# External Integrations
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
TEAMS_WEBHOOK_URL=
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
SERVICENOW_INSTANCE=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@finops.example.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Secrets Management
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_NAMESPACE=

# Development
DEV_MODE=true
MOCK_EXTERNAL_SERVICES=true
