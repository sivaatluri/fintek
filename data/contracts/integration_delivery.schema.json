{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://finops.example.com/schemas/integration_delivery.schema.json",
  "title": "Integration Delivery Record",
  "description": "Schema for tracking delivery of notifications and data to external integrations",
  "type": "object",
  "required": [
    "delivery_id",
    "tenant_id",
    "integration_type",
    "status",
    "created_at"
  ],
  "properties": {
    "delivery_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this delivery attempt"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid",
      "description": "Tenant identifier"
    },
    "workflow_execution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Associated workflow execution (if applicable)"
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Source event that triggered this delivery"
    },
    "integration_type": {
      "type": "string",
      "enum": [
        "email",
        "slack",
        "microsoft_teams",
        "jira",
        "servicenow",
        "zendesk",
        "pagerduty",
        "webhook",
        "custom_api"
      ],
      "description": "Type of integration"
    },
    "integration_id": {
      "type": "string",
      "format": "uuid",
      "description": "Identifier of the integration configuration"
    },
    "integration_name": {
      "type": "string",
      "description": "Human-readable integration name"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "queued",
        "sending",
        "delivered",
        "failed",
        "retrying",
        "cancelled"
      ],
      "description": "Delivery status"
    },
    "delivery_method": {
      "type": "string",
      "enum": ["synchronous", "asynchronous", "queued"],
      "description": "How the delivery was/will be attempted"
    },
    "payload": {
      "type": "object",
      "description": "The payload that was/will be delivered",
      "required": ["template_id", "data"],
      "properties": {
        "template_id": {
          "type": "string",
          "description": "Template used for formatting"
        },
        "template_version": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "description": "Data used to render the template",
          "additionalProperties": true
        },
        "rendered_content": {
          "type": "object",
          "description": "Rendered/formatted content",
          "properties": {
            "subject": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "html": {
              "type": "string"
            },
            "attachments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "filename": {
                    "type": "string"
                  },
                  "content_type": {
                    "type": "string"
                  },
                  "size_bytes": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "destination": {
      "type": "object",
      "description": "Delivery destination details",
      "properties": {
        "email_addresses": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "email"
          }
        },
        "slack_channel": {
          "type": "string"
        },
        "teams_channel": {
          "type": "string"
        },
        "jira_project": {
          "type": "string"
        },
        "servicenow_assignment_group": {
          "type": "string"
        },
        "webhook_url": {
          "type": "string",
          "format": "uri"
        },
        "api_endpoint": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "response": {
      "type": "object",
      "description": "Response from the integration",
      "properties": {
        "status_code": {
          "type": "integer"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {
          "type": "string"
        },
        "external_id": {
          "type": "string",
          "description": "External reference ID (e.g., Jira ticket ID, email message ID)"
        },
        "external_url": {
          "type": "string",
          "format": "uri",
          "description": "URL to view the item in external system"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the delivery was created"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the delivery was sent"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When delivery was confirmed"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Time taken for delivery in milliseconds"
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of retry attempts"
    },
    "max_retries": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum number of retries allowed"
    },
    "next_retry_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the next retry is scheduled"
    },
    "error": {
      "type": "object",
      "description": "Error information if delivery failed",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        },
        "is_retryable": {
          "type": "boolean"
        }
      }
    },
    "idempotency_key": {
      "type": "string",
      "description": "Key to prevent duplicate deliveries"
    },
    "priority": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"],
      "description": "Delivery priority"
    },
    "metadata": {
      "type": "object",
      "description": "Additional delivery metadata",
      "properties": {
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "user_agent": {
          "type": "string"
        },
        "source_ip": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}