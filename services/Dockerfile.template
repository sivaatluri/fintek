# Standardized Dockerfile Template for FinOps Services
# Can be reused across all Python FastAPI services with minimal changes

# Stage 1: Build dependencies
FROM python:3.11-slim as builder

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy common package
COPY packages/common-py /app/packages/common-py

# ARG for service name - can be passed during build
ARG SERVICE_NAME=service
COPY services/${SERVICE_NAME}/requirements.txt /app/requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir --user -r requirements.txt

# Stage 2: Runtime
FROM python:3.11-slim

ARG SERVICE_NAME=service
ENV SERVICE_NAME=${SERVICE_NAME}

WORKDIR /app

# Create non-root user
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app

# Copy dependencies from builder
COPY --from=builder /root/.local /home/appuser/.local
COPY --from=builder /app/packages/common-py /app/packages/common-py

# Copy application code
COPY --chown=appuser:appuser services/${SERVICE_NAME}/src /app/src

# Switch to non-root user
USER appuser

# Update PATH
ENV PATH=/home/appuser/.local/bin:$PATH
ENV PYTHONPATH=/app

# Expose port (default 8000, override with ENV)
ARG PORT=8000
ENV PORT=${PORT}
EXPOSE ${PORT}

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:${PORT}/health')" || exit 1

# Run application
CMD uvicorn src.main:app --host 0.0.0.0 --port ${PORT}
